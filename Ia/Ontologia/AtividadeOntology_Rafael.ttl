#################################################################
#    Annotation properties
#################################################################

###  http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled
<http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/lenovo/ontologies/2026/4/untitled-ontology-2#temIntensidadeAr
:temIntensidadeAr rdf:type owl:ObjectProperty ;
                  rdfs:domain :Recinto ;
                  rdfs:range :Intensidade .


###  http://www.semanticweb.org/lenovo/ontologies/2026/4/untitled-ontology-2#temIntensidadeLuz
:temIntensidadeLuz rdf:type owl:ObjectProperty ;
                   rdfs:domain :Recinto ;
                   rdfs:range :Intensidade .


###  http://www.semanticweb.org/lenovo/ontologies/2026/4/untitled-ontology-2#temPessoa
:temPessoa rdf:type owl:ObjectProperty ;
           rdfs:domain :Recinto ;
           rdfs:range :Pessoa .


###  http://www.semanticweb.org/lenovo/ontologies/2026/4/untitled-ontology-2#temPreferenciaLuz
:temPreferenciaLuz rdf:type owl:ObjectProperty ;
                   rdfs:domain :Pessoa ;
                   rdfs:range :Intensidade .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/lenovo/ontologies/2026/4/untitled-ontology-2#Adulto
:Adulto rdf:type owl:Class ;
        rdfs:subClassOf :Pessoa .


###  http://www.semanticweb.org/lenovo/ontologies/2026/4/untitled-ontology-2#Crianca
:Crianca rdf:type owl:Class ;
         rdfs:subClassOf :Pessoa .


###  http://www.semanticweb.org/lenovo/ontologies/2026/4/untitled-ontology-2#Idoso
:Idoso rdf:type owl:Class ;
       rdfs:subClassOf :Pessoa .


###  http://www.semanticweb.org/lenovo/ontologies/2026/4/untitled-ontology-2#Intensidade
:Intensidade rdf:type owl:Class .


###  http://www.semanticweb.org/lenovo/ontologies/2026/4/untitled-ontology-2#Pessoa
:Pessoa rdf:type owl:Class .


###  http://www.semanticweb.org/lenovo/ontologies/2026/4/untitled-ontology-2#QuartoDeReflexao
:QuartoDeReflexao rdf:type owl:Class ;
                  rdfs:subClassOf :Recinto .


###  http://www.semanticweb.org/lenovo/ontologies/2026/4/untitled-ontology-2#Recinto
:Recinto rdf:type owl:Class .


#################################################################
#    Individuals
#################################################################

###  http://www.semanticweb.org/lenovo/ontologies/2026/4/untitled-ontology-2#Alta
:Alta rdf:type owl:NamedIndividual ,
               :Intensidade .


###  http://www.semanticweb.org/lenovo/ontologies/2026/4/untitled-ontology-2#Baixa
:Baixa rdf:type owl:NamedIndividual ,
                :Intensidade .


###  http://www.semanticweb.org/lenovo/ontologies/2026/4/untitled-ontology-2#Joao
:Joao rdf:type owl:NamedIndividual ,
               :Adulto ;
      :temPreferenciaLuz :Baixa .


###  http://www.semanticweb.org/lenovo/ontologies/2026/4/untitled-ontology-2#Jose
:Jose rdf:type owl:NamedIndividual ,
               :Idoso ;
      :temPreferenciaLuz :Alta .


###  http://www.semanticweb.org/lenovo/ontologies/2026/4/untitled-ontology-2#Media
:Media rdf:type owl:NamedIndividual ,
                :Intensidade .


###  http://www.semanticweb.org/lenovo/ontologies/2026/4/untitled-ontology-2#Pedro
:Pedro rdf:type owl:NamedIndividual ,
                :Crianca ;
       :temPreferenciaLuz :Media .


###  http://www.semanticweb.org/lenovo/ontologies/2026/4/untitled-ontology-2#Teste1
:Teste1 rdf:type owl:NamedIndividual ,
                 :QuartoDeReflexao ;
        :temPessoa :Joao .


###  http://www.semanticweb.org/lenovo/ontologies/2026/4/untitled-ontology-2#Teste2
:Teste2 rdf:type owl:NamedIndividual ,
                 :QuartoDeReflexao ;
        :temPessoa :Pedro .


###  http://www.semanticweb.org/lenovo/ontologies/2026/4/untitled-ontology-2#Teste3
:Teste3 rdf:type owl:NamedIndividual ,
                 :QuartoDeReflexao ;
        :temPessoa :Jose .


